\def\title#1{
    \vspace*{-6\headheight}\prop@oldidbox  \prop@idbox
    \vspace*{0.5in}
    \prop@info\par
    \vspace*{0.1in}
    \def\@savetitle{#1}\ifx\@empty\@savetitle
    \makebox[\textwidth]{\Large{\bf TITLE:} \hrulefill}\par
    \makebox[\textwidth]{\hrulefill}\par
    \else{\LARGE\bf\@savetitle}\fi
}
    


